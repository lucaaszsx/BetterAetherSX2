+void Vulkan::DescriptorSetUpdateBuilder::BindUpdate(VkDevice device, VkCommandBuffer cmdbuf,
+	VkPipelineBindPoint bind_point, VkPipelineLayout layout, u32 set_index, VkDescriptorSet set, bool clear /*= true*/)
+{
+	pxAssert(m_num_writes > 0);
+
+	for (u32 i = 0; i < m_num_writes; i++)
+		m_writes[i].dstSet = set;
+	vkUpdateDescriptorSets(device, m_num_writes, m_writes.data(), 0, nullptr);
+	vkCmdBindDescriptorSets(cmdbuf, bind_point, layout, set_index, 1, &set, 0, nullptr);
+
+	if (clear)
+		Clear();
+}
