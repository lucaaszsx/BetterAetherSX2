+#ifdef __ANDROID__
+// Files picked through Android's Storage Access Framework have content:// URIs, not paths. The host opens each one
+// as a fresh descriptor, read-only.
+static bool IsContentUri(const char* path)
+{
+	return std::strncmp(path, "content://", 10) == 0;
+}
+
+static std::FILE* OpenContentUriCFile(const char* uri, const char* mode, Error* error)
+{
+	if (std::strpbrk(mode, "wa+"))
+	{
+		Error::SetErrno(error, EROFS);
+		return nullptr;
+	}
+
+	const int fd = FileSystem::Android::OpenContentUri(uri);
+	if (fd < 0)
+	{
+		Error::SetErrno(error, ENOENT);
+		return nullptr;
+	}
+
+	std::FILE* fp = fdopen(fd, mode);
+	if (!fp)
+	{
+		Error::SetErrno(error, errno);
+		close(fd);
+	}
+	return fp;
+}
+
+static bool StatContentUri(const char* uri, struct stat* st)
+{
+	s64 size, modified;
+	if (!FileSystem::Android::StatContentUri(uri, &size, &modified))
+		return false;
+
+	*st = {};
+	st->st_mode = S_IFREG | 0444;
+	st->st_size = size;
+	st->st_mtime = modified;
+	st->st_ctime = modified;
+	return true;
+}
+#endif
